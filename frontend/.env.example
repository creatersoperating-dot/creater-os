# CreatorOS cloud workspace
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Existing Gemini script generation
GOOGLE_GENERATIVE_AI_API_KEY=

# CreatorOS v0.6 server-only narration provider
CREATOROS_VOICE_PROVIDER=openai
CREATOROS_VOICE_MODEL=tts-1
CREATOROS_VOICE_FALLBACK_PROVIDER=none
# Server narration deadline in milliseconds (10000-280000).
CREATOROS_VOICE_REQUEST_TIMEOUT_MS=240000
OPENAI_API_KEY=

# Local development/testing only (never use in production):
# CREATOROS_VOICE_PROVIDER=mock
# CREATOROS_VOICE_MODEL=mock-pcm-v1

# CreatorOS server-only video production provider.
CREATOROS_VIDEO_PROVIDER=disabled
CREATOROS_VIDEO_MODEL=disabled
CREATOROS_VIDEO_FALLBACK_PROVIDER=none
# Server render deadline in milliseconds (30000-300000).
CREATOROS_VIDEO_REQUEST_TIMEOUT_MS=240000
# Active generation recovery occurs only after this lease expires.
CREATOROS_VIDEO_ACTIVE_LEASE_MS=30000
# Heartbeats extend the active lease; the lease must be at least 3x this value.
CREATOROS_VIDEO_HEARTBEAT_MS=5000

# Local development/testing only. The mock renderer refuses production use:
# CREATOROS_VIDEO_PROVIDER=mock
# CREATOROS_VIDEO_MODEL=mock-render-v1

# Production FFmpeg renderer. Configure both values explicitly and use an
# absolute path to an FFmpeg build with libx264 and AAC encoder support.
# CREATOROS_VIDEO_PROVIDER=ffmpeg
# CREATOROS_VIDEO_MODEL=ffmpeg-h264-aac-v1
# CREATOROS_FFMPEG_PATH=/usr/bin/ffmpeg
# CREATOROS_FFPROBE_PATH=/usr/bin/ffprobe
